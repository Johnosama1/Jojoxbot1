{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/api-server run build:vercel && BASE_PATH=/ pnpm --filter @workspace/app run build",
  "outputDirectory": "artifacts/app/dist/public",
  "framework": null,
  "functions": {
    "api/vercel-entry.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/vercel-entry.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
