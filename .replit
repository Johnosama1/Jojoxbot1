modules = ["nodejs-20"]
[agent]
expertMode = true

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18635
externalPort = 3002

[[ports]]
localPort = 23863
externalPort = 3000

[userenv]

[userenv.shared]
PORT = "8080"
MINI_APP_URL = "https://jojoxbot-api-server.vercel.app/"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "NODE_ENV=production node artifacts/api-server/dist/index.mjs"]
build = ["bash", "-c", "pnpm install --frozen-lockfile && pnpm --filter @workspace/api-server run build && BASE_PATH=/ pnpm --filter @workspace/app run build"]
